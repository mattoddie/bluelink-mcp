# Copy to .env and fill in:  cp example.env .env

# --- Your account -----------------------------------------------------------
# The email and password you use in the Bluelink app (Hyundai), the Kia Connect
# app (Kia, formerly UVO) or the Genesis Connect app.
BLUELINK_USERNAME=
BLUELINK_PASSWORD=
# Your app PIN. Europe needs it for remote commands (lock, climate, charging).
BLUELINK_PIN=

# europe | europe-cci | usa | canada | australia | nz | india | china | brazil
# "europe" is the classic Bluelink / Kia Connect Europe service (UK included). If
# login fails and your car uses the newer Hyundai or Kia app, try "europe-cci".
BLUELINK_REGION=europe
# hyundai (Bluelink) | kia (Kia Connect) | genesis (Genesis Connect)
# Set kia for a Kia. Not every brand is available in every region.
BLUELINK_BRAND=hyundai
# Language for the service's responses (Europe only).
BLUELINK_LANGUAGE=en
# Look up a street address for the car's location with OpenStreetMap.
BLUELINK_GEOCODE=false

# Register tools that send commands to the car (lock, climate, charging, hazard lights).
BLUELINK_ALLOW_WRITES=false
# Also register unlock_vehicle. Needs writes too. Think before turning this on.
BLUELINK_ALLOW_UNLOCK=false
# Minimum minutes between waking the car for live data (protects the 12V battery).
BLUELINK_MIN_REFRESH_MINUTES=10
# Minimum seconds before the same command can be sent to the same car again.
BLUELINK_MIN_COMMAND_SECONDS=60
# How long to reuse the last status read before asking Bluelink again.
BLUELINK_CACHE_SECONDS=60
# After Bluelink rejects a login, minutes to wait before trying again (protects the account
# from being locked by repeated attempts). 0 turns the wait off.
BLUELINK_LOGIN_RETRY_MINUTES=5

# --- MCP transport ----------------------------------------------------------
# The image defaults to http. Use stdio for `docker run -i` from an MCP client.
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
# Required for http: clients must send "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Optional comma-separated Host header allow-list (DNS rebinding protection).
MCP_ALLOWED_HOSTS=
# Optional comma-separated Origin allow-list, e.g. https://claude.ai. Needs
# MCP_ALLOWED_HOSTS; with hosts set, requests from other origins get 403.
MCP_ALLOWED_ORIGINS=
